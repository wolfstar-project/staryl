{
	"name": "@wolfstar/staryl",
	"version": "1.0.0",
	"private": true,
	"description": "Your favourite Discord bot for notification, part of WolfStar Network",
	"license": "Apache-2.0",
	"author": "WolfStar Project <contact@wolfstar.rocks>",
	"type": "module",
	"main": "dist/main.mjs",
	"imports": {
		"#generated/prisma": "./dist/generated/prisma/client.mjs",
		"#types": "./dist/lib/types/index.mjs",
		"#types/*": "./dist/lib/types/*.mjs",
		"#lib/*": "./dist/lib/*.mjs",
		"#common/*": "./dist/lib/common/*.mjs",
		"#utils/*": "./dist/lib/utilities/*.mjs"
	},
	"scripts": {
		"build": "tsdown",
		"i18n:generate": "i18next-type-generator ./src/locales/en-US/ ./src/@types/i18next.d.ts --no-prettier",
		"dev": "pnpm build --onSuccess \"pnpm start\"",
		"watch": "pnpm build --watch",
		"watch:start": "pnpm build --onSuccess \"pnpm start\"",
		"prisma:generate": "pnpm prisma generate",
		"clean": "node scripts/build/clean.mjs",
		"start": "node --enable-source-maps dist/main.mjs",
		"lint": "oxlint && oxfmt --check",
		"lint:fix": "oxlint --fix && oxfmt",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "node .husky/install.mjs || true",
		"update:interactive": "taze"
	},
	"dependencies": {
		"@discordjs/builders": "^1.14.1",
		"@discordjs/collection": "^2.1.1",
		"@discordjs/core": "^2.6.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@sapphire/bitfield": "^1.2.4",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/iterator-utilities": "^2.0.1",
		"@sapphire/ratelimits": "^2.4.11",
		"@sapphire/result": "^2.8.0",
		"@sapphire/time-utilities": "^1.7.14",
		"@sapphire/utilities": "^3.18.2",
		"@wolfstar/env-utilities": "^2.0.8",
		"@wolfstar/http-framework": "^3.2.1",
		"@wolfstar/logger": "^2.1.6",
		"@wolfstar/plugin-api": "^1.1.4",
		"@wolfstar/plugin-i18next": "^2.0.1",
		"@wolfstar/plugin-subcommands-advanced": "^2.0.2",
		"@wolfstar/safe-fetch": "^1.1.9",
		"@wolfstar/shared-http-pieces": "^1.2.9",
		"@wolfstar/start-banner": "^2.0.9",
		"@wolfstar/twitch-helpers": "^2.0.7",
		"discord-api-types": "^0.38.48",
		"gradient-string": "^3.0.0",
		"husky": "^9.1.7",
		"ioredis": "^6.0.0",
		"nano-staged": "^1.0.2",
		"nanoid": "^6.0.1",
		"tslib": "^2.8.1",
		"untun": "^0.2.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@rollup/plugin-alias": "^6.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^24.13.3",
		"@wolfstar/http-framework-test-utils": "^3.0.6",
		"@wolfstar/i18next-type-generator": "3.1.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.9.1",
		"eslint-plugin-regexp": "^3.2.0",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"prisma": "^7.10.0",
		"taze": "^21.1.0",
		"tsdown": "^0.22.14",
		"typescript": "~5.9.3",
		"vitest": "^4.1.11"
	},
	"nano-staged": {
		"*.{js,ts,mjs,cjs}": [
			"pnpm oxlint --fix"
		],
		"*.{js,ts,mjs,cjs,json,yml,md}": [
			"pnpm oxfmt"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@11.25.0"
}
