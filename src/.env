CLIENT_VERSION=1.0.0

# Client ID which is used for the registry and various API calls
DISCORD_CLIENT_ID=

# Discord Client Public Key
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=

REGISTRY_GUILD_ID=

# Sentry
SENTRY_DSN=

# The address and port on which to start the HTTP server
HTTP_ADDRESS=0.0.0.0
HTTP_PORT=3000

API_ADDRESS=0.0.0.0
API_PORT=3001

# Options required for the /twitch-subscriptions command. The names below are
# the ones `@wolfstar/twitch-helpers` reads; renaming any of them makes
# `addEventSubscription` throw and the `add` subcommand fail.
# `TWITCH_EVENT_SUB_CALLBACK` must be the public URL of the
# `/twitch/event_sub_verify` route and Twitch only accepts HTTPS on port 443,
# so a tunnel is required when developing locally.
TWITCH_EVENT_SUB_CALLBACK="http://localhost:3001/twitch/event_sub_verify"
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_EVENT_SUB_SECRET=2

# Options required for Reddit subscriptions. Reddit's Data API Terms require an
# approved app and its OAuth credentials, so the provider stays off without them:
# create a "script" app at https://www.reddit.com/prefs/apps and request access.
# `REDDIT_USERNAME` is the account the User-Agent names, without the `u/`.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# YouTube requires Data API v3 plus WebSub. Set all three options; the callback
# must be the public HTTPS URL of /youtube/websub. Scheduled checks maintain the
# lease; only baseline, push and retry checks read videos.
YOUTUBE_API_KEY=
YOUTUBE_WEBSUB_CALLBACK=
YOUTUBE_WEBSUB_SECRET=

INTERNAL_RING_URL=
INTERNAL_RING_TOKEN=

# The database URL for Prisma, needs to be copied in a local `.env` at the root
# for Prisma's operations to work.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starly?schema=public"

# Optional. A connection that bypasses the pooler, used only by the Prisma CLI, which
# needs it to change the schema when `DATABASE_URL` goes through PgBouncer in
# transaction mode. Without it the CLI uses `DATABASE_URL`.
DATABASE_DIRECT_URL=

# Optional official X API (billed reads, OAuth 1.0a user context).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional owner-connected professional Instagram accounts.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Stable 32-byte AES key, encoded as 64 hexadecimal characters.
SOCIAL_TOKEN_KEY=

# Optional approved TikTok Login Kit + Display API app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_APP_APPROVED=false
