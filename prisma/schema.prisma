generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id                  BigInt                    @id
  subscriptions       GuildSubscription[]
  socialSubscriptions GuildSocialSubscription[]

  @@map("guild")
}

model GuildSubscription {
  guildId            BigInt             @map("guild_id")
  channelId          BigInt             @map("channel_id")
  message            String?            @db.VarChar(200)
  subscriptionId     BigInt             @map("subscription_id")
  guild              Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  twitchSubscription TwitchSubscription @relation(fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([guildId, channelId, subscriptionId])
  @@map("guild_subscription")
}

model TwitchSubscription {
  id                BigInt                 @id @default(autoincrement())
  streamerId        String                 @map("streamer_id") @db.VarChar(10)
  subscriptionId    String                 @map("subscription_id") @db.VarChar(36)
  subscriptionType  TwitchSubscriptionType
  // Why Twitch ended the EventSub subscription, when it could not be renewed.
  revokedReason     String?                @map("revoked_reason") @db.VarChar(64)
  guildSubscription GuildSubscription[]

  @@unique([streamerId, subscriptionType])
  @@map("twitch_subscriptions")
}

enum TwitchSubscriptionType {
  StreamOnline  @map("stream.online")
  StreamOffline @map("stream.offline")

  @@map("twitch_subscriptions_subscription_type_enum")
}

// One followed account, feed or channel. Shared by every guild that follows it, so it is checked
// once however many guilds subscribe.
model SocialSource {
  id            BigInt                    @id @default(autoincrement())
  provider      SocialProviderName
  target        String                    @db.VarChar(512)
  displayName   String                    @map("display_name") @db.VarChar(200)
  // Owned by the provider, for example the ETag of the last response.
  state         Json?
  lastFailure   SocialFailure?            @map("last_failure")
  failureCount  Int                       @default(0) @map("failure_count")
  websubRequestedAt DateTime? @map("websub_requested_at") @db.Timestamptz
  websubExpiresAt DateTime? @map("websub_expires_at") @db.Timestamptz
  lastCheckedAt DateTime?                 @map("last_checked_at") @db.Timestamptz
  nextCheckAt   DateTime                  @default(now()) @map("next_check_at") @db.Timestamptz
  // Set while a process is checking the source. Its value is what proves a process still owns it.
  claimedUntil  DateTime?                 @map("claimed_until") @db.Timestamptz
  // Asks for a check ahead of schedule. Apart from `nextCheckAt` because a running check rewrites
  // that when it ends, which would lose a request made while it ran.
  checkRequested Boolean                  @default(false) @map("check_requested")
  subscriptions GuildSocialSubscription[]

  @@unique([provider, target])
  @@index([provider, nextCheckAt])
  @@map("social_source")
}

model GuildSocialSubscription {
  guildId       BigInt               @map("guild_id")
  channelId     BigInt               @map("channel_id")
  sourceId      BigInt               @map("source_id")
  message       String?              @db.VarChar(200)
  filters       Json                 @default("{}")
  // Most recent successful delivery; the seen window separately records filtered and baseline items.
  lastNotifiedId String? @map("last_notified_id") @db.VarChar(512)
  // Kept per subscription because a filter can hold an item back for one channel only.
  seenItemIds   String[]             @map("seen_item_ids")
  deliveryError SocialDeliveryError? @map("delivery_error")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  guild         Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // Restrict: a cleanup racing a new subscription must fail, not cascade over the row just added.
  source        SocialSource         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([guildId, channelId, sourceId])
  @@index([sourceId])
  @@map("guild_social_subscription")
}

enum SocialProviderName {
  TikTok
  Instagram
  X
  Rss
  Reddit
  Bluesky
  Mastodon
  YouTube
  TwitchVideos
  TwitchClips

  @@map("social_provider_name_enum")
}

enum SocialFailure {
  RateLimited
  TargetUnavailable
  AuthFailed
  Unavailable
  InvalidResponse

  @@map("social_failure_enum")
}

enum SocialDeliveryError {
  GuildUnavailable
  ChannelNotFound
  MissingPermissions
  SendFailed

  @@map("social_delivery_error_enum")
}

// OAuth credentials never enter source state, command replies or notification payloads.
model SocialConnection {
  provider SocialProviderName
  target String @db.VarChar(512)
  guildId BigInt @map("guild_id")
  displayName String @map("display_name") @db.VarChar(200)
  credentials String
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  refreshingUntil DateTime? @map("refreshing_until") @db.Timestamptz
  @@id([provider, target])
  @@map("social_connection")
}

model SocialOAuthState {
  id String @id @db.VarChar(64)
  provider SocialProviderName
  guildId BigInt @map("guild_id")
  channelId BigInt @map("channel_id")
  userId String @map("user_id")
  filters Json @default("{}")
  message String? @db.VarChar(200)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  @@index([expiresAt])
  @@map("social_oauth_state")
}
