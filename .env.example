# Official X API (OAuth 1.0a user context, read permission)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Instagram API with Instagram Login (professional business/creator accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://bot.example.com/social/instagram/callback
# Generate once with: openssl rand -hex 32. Keep stable to decrypt stored credentials.
SOCIAL_TOKEN_KEY=

# TikTok Login Kit + Display API approval required before enabling
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://bot.example.com/social/tiktok/callback
TIKTOK_APP_APPROVED=false

YOUTUBE_API_KEY=
YOUTUBE_WEBSUB_SECRET=
YOUTUBE_WEBSUB_CALLBACK=https://bot.example.com/youtube/websub
